{
  "manifest_version": 3,
  "name": "Whatnot Mana Leaderboard Sync",
  "version": "1.0.0",
  "description": "Erkennt Live-Käufe auf Whatnot und synchronisiert sie in Echtzeit mit dem OBS Fantasy-Mana Leaderboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Whatnot Mana Leaderboard Status",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "https://*.whatnot.com/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.whatnot.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
